material><mattext texttype="text/plain">Thinks, feels, and sends messages to the body</mattext></material></response_label><response_label ident="g5sci_u03_check_q11_r5"><material><mattext texttype="text/plain">Filter waste and extra water out of the blood</mattext></material></response_label><response_label ident="g5sci_u03_check_q11_r6"><material><mattext texttype="text/plain">Holds you up and protects organs</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="Yes"><conditionvar><other/></conditionvar><displayfeedback feedbacktype="Response" linkrefid="general_fb"/></respcondition><respcondition><conditionvar><varequal respident="response_g5sci_u03_check_q11_l1">g5sci_u03_check_q11_r1</varequal></conditionvar><setvar varname="SCORE" action="Add">20.0</setvar></respcondition><respcondition><conditionvar><varequal respident="response_g5sci_u03_check_q11_l2">g5sci_u03_check_q11_r2</varequal></conditionvar><setvar varname="SCORE" action="Add">20.0</setvar></respcondition><respcondition><conditionvar><varequal respident="response_g5sci_u03_check_q11_l3">g5sci_u03_check_q11_r3</varequal></conditionvar><setvar varname="SCORE" action="Add">20.0</setvar></respcondition><respcondition><conditionvar><varequal respident="response_g5sci_u03_check_q11_l4">g5sci_u03_check_q11_r4</varequal></conditionvar><setvar varname="SCORE" action="Add">20.0</setvar></respcondition><respcondition><conditionvar><varequal respident="response_g5sci_u03_check_q11_l5">g5sci_u03_check_q11_r5</varequal></conditionvar><setvar varname="SCORE" action="Add">20.0</setvar></respcondition></resprocessing><itemfeedback ident="general_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;Each organ has its own function, and they work as a team.&lt;/p&gt;&lt;p&gt;Look back at lesson 19.01, Part 4.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback><itemfeedback ident="correct_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;Each organ has its own function, and they work as a team.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback><itemfeedback ident="general_incorrect_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;Look back at lesson 19.01, Part 4.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback></item>
<item ident="g5sci_u03_check_q12" title="Question 12"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g5sci_u03_check_q12_a,g5sci_u03_check_q12_b,g5sci_u03_check_q12_c,g5sci_u03_check_q12_d</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;A student measured these numbers.&lt;/p&gt;&lt;table border="1" cellpadding="6" style="border-collapse:collapse"&gt;&lt;tr&gt;&lt;th&gt;&lt;/th&gt;&lt;th&gt;At rest&lt;/th&gt;&lt;th&gt;After 1 minute of jumping jacks&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Heartbeats per minute&lt;/td&gt;&lt;td&gt;80&lt;/td&gt;&lt;td&gt;128&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Breaths in 30 seconds&lt;/td&gt;&lt;td&gt;8&lt;/td&gt;&lt;td&gt;14&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p&gt;Which explanation fits this data best?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g5sci_u03_check_q12_a"><material><mattext texttype="text/plain">The heart got tired, so it had to beat faster</mattext></material></response_label><response_label ident="g5sci_u03_check_q12_b"><material><mattext texttype="text/plain">The lungs sent air straight to the muscles, so the heart did not matter</mattext></material></response_label><response_label ident="g5sci_u03_check_q12_c"><material><mattext texttype="text/plain">The muscles needed more oxygen, so the lungs and the heart sped up together to deliver it</mattext></material></response_label><response_label ident="g5sci_u03_check_q12_d"><material><mattext texttype="text/plain">The digestive system sped up the heart</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g5sci_u03_check_q12_c</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar><displayfeedback feedbacktype="Response" linkrefid="correct_fb"/></respcondition><respcondition continue="Yes"><conditionvar><other/></conditionvar><displayfeedback feedbacktype="Response" linkrefid="general_incorrect_fb"/></respcondition></resprocessing><itemfeedback ident="general_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;Working muscles need more oxygen. The lungs bring it into the blood and the heart pumps that blood to the muscles, so both speed up.&lt;/p&gt;&lt;p&gt;Look back at lesson 19.02, Part 4.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback><itemfeedback ident="correct_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;Working muscles need more oxygen. The lungs bring it into the blood and the heart pumps that blood to the muscles, so both speed up.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback><itemfeedback ident="general_incorrect_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;Look back at lesson 19.02, Part 4.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback></item>
<item ident="g5sci_u03_check_q13" title="Question 13"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g5sci_u03_check_q13_a,g5sci_u03_check_q13_b,g5sci_u03_check_q13_c,g5sci_u03_check_q13_d</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;In a box-and-arrow model of body systems, what does the arrow from the lungs to the heart and blood carry?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g5sci_u03_check_q13_a"><material><mattext texttype="text/plain">Nutrients</mattext></material></response_label><response_label ident="g5sci_u03_check_q13_b"><material><mattext texttype="text/plain">Carbon dioxide</mattext></material></response_label><response_label ident="g5sci_u03_check_q13_c"><material><mattext texttype="text/plain">Oxygen</mattext></material></response_label><response_label ident="g5sci_u03_check_q13_d"><material><mattext texttype="text/plain">Signals</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g5sci_u03_check_q13_c</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar><displayfeedback feedbacktype="Response" linkrefid="correct_fb"/></respcondition><respcondition continue="Yes"><conditionvar><other/></conditionvar><displayfeedback feedbacktype="Response" linkrefid="general_incorrect_fb"/></respcondition></resprocessing><itemfeedback ident="general_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;In the lungs, oxygen moves from the air into the blood. Carbon dioxide goes the other way, out of the blood and out with your breath.&lt;/p&gt;&lt;p&gt;Look back at lesson 19.02, Part 4.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback><itemfeedback ident="correct_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;In the lungs, oxygen moves from the air into the blood. Carbon dioxide goes the other way, out of the blood and out with your breath.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback><itemfeedback ident="general_incorrect_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;Look back at lesson 19.02, Part 4.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback></item>
</section></assessment></questestinterop>
