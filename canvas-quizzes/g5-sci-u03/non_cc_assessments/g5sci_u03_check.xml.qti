<?xml version="1.0" encoding="UTF-8"?>
<questestinterop xmlns="http://www.imsglobal.org/xsd/ims_qtiasiv1p2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.imsglobal.org/xsd/ims_qtiasiv1p2 http://www.imsglobal.org/xsd/ims_qtiasiv1p2p1.xsd">
<assessment ident="g5sci_u03_check" title="Unit 3 Check: Forces, Plants, and Body Systems"><qtimetadata><qtimetadatafield><fieldlabel>cc_maxattempts</fieldlabel><fieldentry>1</fieldentry></qtimetadatafield></qtimetadata><section ident="root_section">
<item ident="g5sci_u03_check_q1" title="Question 1"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g5sci_u03_check_q1_a,g5sci_u03_check_q1_b,g5sci_u03_check_q1_c,g5sci_u03_check_q1_d</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;A soccer ball and a bowling ball sit on the floor. You give each one the same gentle kick. What happens?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g5sci_u03_check_q1_a"><material><mattext texttype="text/plain">The soccer ball rolls farther, because it has less mass</mattext></material></response_label><response_label ident="g5sci_u03_check_q1_b"><material><mattext texttype="text/plain">The bowling ball rolls farther, because heavy things keep going</mattext></material></response_label><response_label ident="g5sci_u03_check_q1_c"><material><mattext texttype="text/plain">They roll the same distance, because the kicks were the same</mattext></material></response_label><response_label ident="g5sci_u03_check_q1_d"><material><mattext texttype="text/plain">Neither one moves, because the forces are balanced</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g5sci_u03_check_q1_a</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar><displayfeedback feedbacktype="Response" linkrefid="correct_fb"/></respcondition><respcondition continue="Yes"><conditionvar><other/></conditionvar><displayfeedback feedbacktype="Response" linkrefid="general_incorrect_fb"/></respcondition></resprocessing><itemfeedback ident="general_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;The same force has a bigger effect on an object with less mass.&lt;/p&gt;&lt;p&gt;Look back at lesson 16.01, Part 1.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback><itemfeedback ident="correct_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;The same force has a bigger effect on an object with less mass.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback><itemfeedback ident="general_incorrect_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;Look back at lesson 16.01, Part 1.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback></item>
<item ident="g5sci_u03_check_q2" title="Question 2"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g5sci_u03_check_q2_a,g5sci_u03_check_q2_b,g5sci_u03_check_q2_c,g5sci_u03_check_q2_d</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;Two dogs pull on opposite ends of a rope toy. The toy slowly moves toward the bigger dog. What does this show?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g5sci_u03_check_q2_a"><material><mattext texttype="text/plain">The forces are balanced</mattext></material></response_label><response_label ident="g5sci_u03_check_q2_b"><material><mattext texttype="text/plain">The forces are unbalanced, and the bigger dog pulls with more force</mattext></material></response_label><response_label ident="g5sci_u03_check_q2_c"><material><mattext texttype="text/plain">No forces are acting on the toy</mattext></material></response_label><response_label ident="g5sci_u03_check_q2_d"><material><mattext texttype="text/plain">The smaller dog is pulling harder</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g5sci_u03_check_q2_b</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar><displayfeedback feedbacktype="Response" linkrefid="correct_fb"/></respcondition><respcondition continue="Yes"><conditionvar><other/></conditionvar><displayfeedback feedbacktype="Response" linkrefid="general_incorrect_fb"/></respcondition></resprocessing><itemfeedback ident="general_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;When opposite forces are not equal, the object moves toward the bigger force.&lt;/p&gt;&lt;p&gt;Look back at lesson 16.01, Part 2.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback><itemfeedback ident="correct_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;When opposite forces are not equal, the object moves toward the bigger force.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback><itemfeedback ident="general_incorrect_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;Look back at lesson 16.01, Part 2.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback></item>
<item ident="g5sci_u03_check_q3" title="Question 3"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g5sci_u03_check_q3_a,g5sci_u03_check_q3_b,g5sci_u03_check_q3_c,g5sci_u03_check_q3_d</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;A student flicked two objects with the same push, three times each, and measured how far they slid.&lt;/p&gt;&lt;table border="1" cellpadding="6" style="border-collapse:collapse"&gt;&lt;tr&gt;&lt;th&gt;Object&lt;/th&gt;&lt;th&gt;Trial 1&lt;/th&gt;&lt;th&gt;Trial 2&lt;/th&gt;&lt;th&gt;Trial 3&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Tennis ball (light)&lt;/td&gt;&lt;td&gt;42 cm&lt;/td&gt;&lt;td&gt;38 cm&lt;/td&gt;&lt;td&gt;40 cm&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Hardcover book (heavy)&lt;/td&gt;&lt;td&gt;7 cm&lt;/td&gt;&lt;td&gt;5 cm&lt;/td&gt;&lt;td&gt;6 cm&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p&gt;Which conclusion does this data support?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g5sci_u03_check_q3_a"><material><mattext texttype="text/plain">The book moved less because it was pushed with less force</mattext></material></response_label><response_label ident="g5sci_u03_check_q3_b"><material><mattext texttype="text/plain">Mass does not change how far an object moves</mattext></material></response_label><response_label ident="g5sci_u03_check_q3_c"><material><mattext texttype="text/plain">The same push moved the light object much farther, so more mass means less motion from the same force</mattext></material></response_label><response_label ident="g5sci_u03_check_q3_d"><material><mattext texttype="text/plain">The heavy object moved farther on average</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g5sci_u03_check_q3_c</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar><displayfeedback feedbacktype="Response" linkrefid="correct_fb"/></respcondition><respcondition continue="Yes"><conditionvar><other/></conditionvar><displayfeedback feedbacktype="Response" linkrefid="general_incorrect_fb"/></respcondition></resprocessing><itemfeedback ident="general_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;The pushes were the same, and the light ball went about 40 cm while the book went about 6 cm.&lt;/p&gt;&lt;p&gt;Look back at lesson 16.02, Investigate.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback><itemfeedback ident="correct_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;The pushes were the same, and the light ball went about 40 cm while the book went about 6 cm.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback><itemfeedback ident="general_incorrect_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;Look back at lesson 16.02, Investigate.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback></item>
<item ident="g5sci_u03_check_q4" title="Question 4"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g5sci_u03_check_q4_a,g5sci_u03_check_q4_b,g5sci_u03_check_q4_c,g5sci_u03_check_q4_d</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;In the mass test, why should both objects get the same push?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g5sci_u03_check_q4_a"><material><mattext texttype="text/plain">So both objects stop in the same place</mattext></material></response_label><response_label ident="g5sci_u03_check_q4_b"><material><mattext texttype="text/plain">So the heavy object can win</mattext></material></response_label><response_label ident="g5sci_u03_check_q4_c"><material><mattext texttype="text/plain">It does not matter how hard you push each one</mattext></material></response_label><response_label ident="g5sci_u03_check_q4_d"><material><mattext texttype="text/plain">So the only thing that changes is the mass, and the test is fair</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g5sci_u03_check_q4_d</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar><displayfeedback feedbacktype="Response" linkrefid="correct_fb"/></respcondition><respcondition continue="Yes"><conditionvar><other/></conditionvar><displayfeedback feedbacktype="Response" linkrefid="general_incorrect_fb"/></respcondition></resprocessing><itemfeedback ident="general_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;A fair test changes only one thing. Then any difference in the results comes from the mass.&lt;/p&gt;&lt;p&gt;Look back at lesson 16.02, Part 1.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback><itemfeedback ident="correct_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;A fair test changes only one thing. Then any difference in the results comes from the mass.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback><itemfeedback ident="general_incorrect_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;Look back at lesson 16.02, Part 1.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback></item>
<item ident="g5sci_u03_check_q5" title="Question 5"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g5sci_u03_check_q5_a,g5sci_u03_check_q5_b,g5sci_u03_check_q5_c,g5sci_u03_check_q5_d</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;A pumpkin vine grows from one small seed into a plant with 10 kilograms of leaves, stems, and pumpkins. The soil in its pot barely changes. Where did most of the plant&amp;#x27;s new mass come from?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g5sci_u03_check_q5_a"><material><mattext texttype="text/plain">Nutrients the roots pulled out of the soil</mattext></material></response_label><response_label ident="g5sci_u03_check_q5_b"><material><mattext texttype="text/plain">Carbon dioxide from the air, and water</mattext></material></response_label><response_label ident="g5sci_u03_check_q5_c"><material><mattext texttype="text/plain">Sunlight that turned into solid material</mattext></material></response_label><response_label ident="g5sci_u03_check_q5_d"><material><mattext texttype="text/plain">The fertilizer that was added to the pot</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g5sci_u03_check_q5_b</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar><displayfeedback feedbacktype="Response" linkrefid="correct_fb"/></respcondition><respcondition continue="Yes"><conditionvar><other/></conditionvar><displayfeedback feedbacktype="Response" linkrefid="general_incorrect_fb"/></respcondition></resprocessing><itemfeedback ident="general_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;Plants build their bodies mostly from carbon dioxide and water. Sunlight gives the energy, but it is not the material.&lt;/p&gt;&lt;p&gt;Look back at lesson 17.01, Part 2.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback><itemfeedback ident="correct_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;Plants build their bodies mostly from carbon dioxide and water. Sunlight gives the energy, but it is not the material.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback><itemfeedback ident="general_incorrect_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;Look back at lesson 17.01, Part 2.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback></item>
<item ident="g5sci_u03_check_q6" title="Question 6"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>true_false_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g5sci_u03_check_q6_a,g5sci_u03_check_q6_b</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;True or false: Fertilizer is the food that plants eat to build their bodies.&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g5sci_u03_check_q6_a"><material><mattext texttype="text/plain">True</mattext></material></response_label><response_label ident="g5sci_u03_check_q6_b"><material><mattext texttype="text/plain">False</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g5sci_u03_check_q6_b</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar><displayfeedback feedbacktype="Response" linkrefid="correct_fb"/></respcondition><respcondition continue="Yes"><conditionvar><other/></conditionvar><displayfeedback feedbacktype="Response" linkrefid="general_incorrect_fb"/></respcondition></resprocessing><itemfeedback ident="general_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;Fertilizer adds small amounts of nutrients, minerals like nitrogen, that help plants grow. Plants make their own food using light, air, and water.&lt;/p&gt;&lt;p&gt;Look back at lesson 17.01, Part 3.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback><itemfeedback ident="correct_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;Fertilizer adds small amounts of nutrients, minerals like nitrogen, that help plants grow. Plants make their own food using light, air, and water.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback><itemfeedback ident="general_incorrect_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;Look back at lesson 17.01, Part 3.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback></item>
<item ident="g5sci_u03_check_q7" title="Question 7"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>matching_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g5sci_u03_check_q7_l1,g5sci_u03_check_q7_l2,g5sci_u03_check_q7_l3</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;Match each sentence to the part of a scientific argument it is.&lt;/p&gt;</mattext></material><response_lid ident="response_g5sci_u03_check_q7_l1"><material><mattext texttype="text/plain">Plants get most of their mass from air and water.</mattext></material><render_choice><response_label ident="g5sci_u03_check_q7_r1"><material><mattext texttype="text/plain">Claim</mattext></material></response_label><response_label ident="g5sci_u03_check_q7_r2"><material><mattext texttype="text/plain">Evidence</mattext></material></response_label><response_label ident="g5sci_u03_check_q7_r3"><material><mattext texttype="text/plain">Reasoning</mattext></material></response_label><response_label ident="g5sci_u03_check_q7_r4"><material><mattext texttype="text/plain">Prediction</mattext></material></response_label></render_choice></response_lid><response_lid ident="response_g5sci_u03_check_q7_l2"><material><mattext texttype="text/plain">The willow tree gained 164 pounds while the soil lost only 2 ounces.</mattext></material><render_choice><response_label ident="g5sci_u03_check_q7_r1"><material><mattext texttype="text/plain">Claim</mattext></material></response_label><response_label ident="g5sci_u03_check_q7_r2"><material><mattext texttype="text/plain">Evidence</mattext></material></response_label><response_label ident="g5sci_u03_check_q7_r3"><material><mattext texttype="text/plain">Reasoning</mattext></material></response_label><response_label ident="g5sci_u03_check_q7_r4"><material><mattext texttype="text/plain">Prediction</mattext></material></response_label></render_choice></response_lid><response_lid ident="response_g5sci_u03_check_q7_l3"><material><mattext texttype="text/plain">The soil barely changed, so the tree's new mass must have come from somewhere else, like the air and water.</mattext></material><render_choice><response_label ident="g5sci_u03_check_q7_r1"><material><mattext texttype="text/plain">Claim</mattext></material></response_label><response_label ident="g5sci_u03_check_q7_r2"><material><mattext texttype="text/plain">Evidence</mattext></material></response_label><response_label ident="g5sci_u03_check_q7_r3"><material><mattext texttype="text/plain">Reasoning</mattext></material></response_label><response_label ident="g5sci_u03_check_q7_r4"><material><mattext texttype="text/plain">Prediction</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="Yes"><conditionvar><other/></conditionvar><displayfeedback feedbacktype="Response" linkrefid="general_fb"/></respcondition><respcondition><conditionvar><varequal respident="response_g5sci_u03_check_q7_l1">g5sci_u03_check_q7_r1</varequal></conditionvar><setvar varname="SCORE" action="Add">33.33</setvar></respcondition><respcondition><conditionvar><varequal respident="response_g5sci_u03_check_q7_l2">g5sci_u03_check_q7_r2</varequal></conditionvar><setvar varname="SCORE" action="Add">33.33</setvar></respcondition><respcondition><conditionvar><varequal respident="response_g5sci_u03_check_q7_l3">g5sci_u03_check_q7_r3</varequal></conditionvar><setvar varname="SCORE" action="Add">33.33</setvar></respcondition></resprocessing><itemfeedback ident="general_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;A claim says what is true, evidence is the data, and reasoning explains how the data proves the claim.&lt;/p&gt;&lt;p&gt;Look back at lesson 17.02, Part 1.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback><itemfeedback ident="correct_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;A claim says what is true, evidence is the data, and reasoning explains how the data proves the claim.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback><itemfeedback ident="general_incorrect_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;Look back at lesson 17.02, Part 1.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback></item>
<item ident="g5sci_u03_check_q8" title="Question 8"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g5sci_u03_check_q8_a,g5sci_u03_check_q8_b,g5sci_u03_check_q8_c,g5sci_u03_check_q8_d</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;A plant was sealed in a clear jar with a carbon dioxide meter.&lt;/p&gt;&lt;table border="1" cellpadding="6" style="border-collapse:collapse"&gt;&lt;tr&gt;&lt;th&gt;Time&lt;/th&gt;&lt;th&gt;Lamp&lt;/th&gt;&lt;th&gt;Carbon dioxide in the jar&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Start&lt;/td&gt;&lt;td&gt;on&lt;/td&gt;&lt;td&gt;420&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;After 2 hours&lt;/td&gt;&lt;td&gt;on&lt;/td&gt;&lt;td&gt;200&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;After 4 hours&lt;/td&gt;&lt;td&gt;off for the last 2 hours&lt;/td&gt;&lt;td&gt;230&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p&gt;What does this data show?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g5sci_u03_check_q8_a"><material><mattext texttype="text/plain">The plant took in carbon dioxide all the time, light or dark</mattext></material></response_label><response_label ident="g5sci_u03_check_q8_b"><material><mattext texttype="text/plain">The plant took in carbon dioxide while it had light, and stopped when the light was off</mattext></material></response_label><response_label ident="g5sci_u03_check_q8_c"><material><mattext texttype="text/plain">The soil soaked up the carbon dioxide</mattext></material></response_label><response_label ident="g5sci_u03_check_q8_d"><material><mattext texttype="text/plain">The jar must have had a leak</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g5sci_u03_check_q8_b</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar><displayfeedback feedbacktype="Response" linkrefid="correct_fb"/></respcondition><respcondition continue="Yes"><conditionvar><other/></conditionvar><displayfeedback feedbacktype="Response" linkrefid="general_incorrect_fb"/></respcondition></resprocessing><itemfeedback ident="general_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;The number fell with the lamp on and crept back up with the lamp off. Light powers the plant&amp;#x27;s building.&lt;/p&gt;&lt;p&gt;Look back at lesson 17.02, Part 4.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback><itemfeedback ident="correct_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;The number fell with the lamp on and crept back up with the lamp off. Light powers the plant&amp;#x27;s building.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback><itemfeedback ident="general_incorrect_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;Look back at lesson 17.02, Part 4.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback></item>
<item ident="g5sci_u03_check_q9" title="Question 9"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g5sci_u03_check_q9_a,g5sci_u03_check_q9_b,g5sci_u03_check_q9_c,g5sci_u03_check_q9_d</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;Which of these living things can make its own food using energy from sunlight?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g5sci_u03_check_q9_a"><material><mattext texttype="text/plain">A rabbit</mattext></material></response_label><response_label ident="g5sci_u03_check_q9_b"><material><mattext texttype="text/plain">An oak tree</mattext></material></response_label><response_label ident="g5sci_u03_check_q9_c"><material><mattext texttype="text/plain">A hawk</mattext></material></response_label><response_label ident="g5sci_u03_check_q9_d"><material><mattext texttype="text/plain">A grasshopper</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g5sci_u03_check_q9_b</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar><displayfeedback feedbacktype="Response" linkrefid="correct_fb"/></respcondition><respcondition continue="Yes"><conditionvar><other/></conditionvar><displayfeedback feedbacktype="Response" linkrefid="general_incorrect_fb"/></respcondition></resprocessing><itemfeedback ident="general_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;Plants are producers. They use sunlight to make food. Animals are consumers and must eat.&lt;/p&gt;&lt;p&gt;Look back at lesson 18.01, Part 1.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback><itemfeedback ident="correct_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;Plants are producers. They use sunlight to make food. Animals are consumers and must eat.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback><itemfeedback ident="general_incorrect_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;Look back at lesson 18.01, Part 1.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback></item>
<item ident="g5sci_u03_check_q10" title="Question 10"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g5sci_u03_check_q10_a,g5sci_u03_check_q10_b,g5sci_u03_check_q10_c,g5sci_u03_check_q10_d</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;In the food chain model Grass → Rabbit → Fox, what does the arrow from the rabbit to the fox stand for?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g5sci_u03_check_q10_a"><material><mattext texttype="text/plain">The rabbit eats the fox</mattext></material></response_label><response_label ident="g5sci_u03_check_q10_b"><material><mattext texttype="text/plain">Energy moves from the rabbit to the fox when the fox eats it</mattext></material></response_label><response_label ident="g5sci_u03_check_q10_c"><material><mattext texttype="text/plain">The fox gives energy to the rabbit</mattext></material></response_label><response_label ident="g5sci_u03_check_q10_d"><material><mattext texttype="text/plain">The rabbit runs toward the fox</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g5sci_u03_check_q10_b</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar><displayfeedback feedbacktype="Response" linkrefid="correct_fb"/></respcondition><respcondition continue="Yes"><conditionvar><other/></conditionvar><displayfeedback feedbacktype="Response" linkrefid="general_incorrect_fb"/></respcondition></resprocessing><itemfeedback ident="general_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;Food chain arrows point toward the eater. They show which way the energy flows.&lt;/p&gt;&lt;p&gt;Look back at lesson 18.02, Part 2.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback><itemfeedback ident="correct_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;Food chain arrows point toward the eater. They show which way the energy flows.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback><itemfeedback ident="general_incorrect_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;Look back at lesson 18.02, Part 2.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback></item>
<item ident="g5sci_u03_check_q11" title="Question 11"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>matching_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g5sci_u03_check_q11_l1,g5sci_u03_check_q11_l2,g5sci_u03_check_q11_l3,g5sci_u03_check_q11_l4,g5sci_u03_check_q11_l5</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;Match each organ to its main job.&lt;/p&gt;</mattext></material><response_lid ident="response_g5sci_u03_check_q11_l1"><material><mattext texttype="text/plain">Heart</mattext></material><render_choice><response_label ident="g5sci_u03_check_q11_r1"><material><mattext texttype="text/plain">Pumps blood to every part of the body</mattext></material></response_label><response_label ident="g5sci_u03_check_q11_r2"><material><mattext texttype="text/plain">Take in oxygen and push out carbon dioxide</mattext></material></response_label><response_label ident="g5sci_u03_check_q11_r3"><material><mattext texttype="text/plain">Mashes food and mixes it with juices</mattext></material></response_label><response_label ident="g5sci_u03_check_q11_r4"><material><mattext texttype="text/plain">Thinks, feels, and sends messages to the body</mattext></material></response_label><response_label ident="g5sci_u03_check_q11_r5"><material><mattext texttype="text/plain">Filter waste and extra water out of the blood</mattext></material></response_label><response_label ident="g5sci_u03_check_q11_r6"><material><mattext texttype="text/plain">Holds you up and protects organs</mattext></material></response_label></render_choice></response_lid><response_lid ident="response_g5sci_u03_check_q11_l2"><material><mattext texttype="text/plain">Lungs</mattext></material><render_choice><response_label ident="g5sci_u03_check_q11_r1"><material><mattext texttype="text/plain">Pumps blood to every part of the body</mattext></material></response_label><response_label ident="g5sci_u03_check_q11_r2"><material><mattext texttype="text/plain">Take in oxygen and push out carbon dioxide</mattext></material></response_label><response_label ident="g5sci_u03_check_q11_r3"><material><mattext texttype="text/plain">Mashes food and mixes it with juices</mattext></material></response_label><response_label ident="g5sci_u03_check_q11_r4"><material><mattext texttype="text/plain">Thinks, feels, and sends messages to the body</mattext></material></response_label><response_label ident="g5sci_u03_check_q11_r5"><material><mattext texttype="text/plain">Filter waste and extra water out of the blood</mattext></material></response_label><response_label ident="g5sci_u03_check_q11_r6"><material><mattext texttype="text/plain">Holds you up and protects organs</mattext></material></response_label></render_choice></response_lid><response_lid ident="response_g5sci_u03_check_q11_l3"><material><mattext texttype="text/plain">Stomach</mattext></material><render_choice><response_label ident="g5sci_u03_check_q11_r1"><material><mattext texttype="text/plain">Pumps blood to every part of the body</mattext></material></response_label><response_label ident="g5sci_u03_check_q11_r2"><material><mattext texttype="text/plain">Take in oxygen and push out carbon dioxide</mattext></material></response_label><response_label ident="g5sci_u03_check_q11_r3"><material><mattext texttype="text/plain">Mashes food and mixes it with juices</mattext></material></response_label><response_label ident="g5sci_u03_check_q11_r4"><material><mattext texttype="text/plain">Thinks, feels, and sends messages to the body</mattext></material></response_label><response_label ident="g5sci_u03_check_q11_r5"><material><mattext texttype="text/plain">Filter waste and extra water out of the blood</mattext></material></response_label><response_label ident="g5sci